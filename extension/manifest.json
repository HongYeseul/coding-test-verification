{
  "manifest_version": 3,
  "name": "도장",
  "version": "0.2.13",
  "description": "보고 있는 화면이나 방금 맞힌 풀이로 스터디 도장을 찍습니다.",
  "key": "",
  "permissions": [
    "activeTab",
    "identity",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://coding-test-verification.vercel.app/*",
    "https://dzibporiiexvsndungkx.supabase.co/*",
    "https://school.programmers.co.kr/learn/courses/30/lessons/*",
    "https://neetcode.io/*",
    "https://leetcode.com/*"
  ],
  "action": {
    "default_title": "도장 찍기",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://school.programmers.co.kr/learn/courses/30/lessons/*"
      ],
      "js": [
        "seal.js",
        "content/confetti.js",
        "content/card.js",
        "content/statement.js",
        "content/programmers.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://neetcode.io/*"
      ],
      "js": [
        "content/neetcode-intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://neetcode.io/*"
      ],
      "js": [
        "seal.js",
        "content/confetti.js",
        "content/card.js",
        "content/neetcode.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content/leetcode-intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "seal.js",
        "content/confetti.js",
        "content/card.js",
        "content/leetcode.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
